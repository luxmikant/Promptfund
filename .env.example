# ==========================================
# PromptFund AI - Environment Variables
# ==========================================

# 1. PayPal Developer Sandbox Credentials
# Get these from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_sandbox_client_id_here

# 2. Supabase Micro-Ledger Credentials
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 3. AI Inference API (Groq is recommended for sub-second Llama 3 70B & 8B)
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Community Node Endpoint (e.g. Local Ollama or Ngrok tunnel)
COMMUNITY_NODE_URL=http://localhost:11434/v1
COMMUNITY_NODE_MODEL=llama3:8b
COMMUNITY_NODE_OPERATOR_PAYPAL=node-beta-operator@sandbox.paypal.com
